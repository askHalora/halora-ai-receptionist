    {
      "id": "0ee64514-85ea-467a-97bb-989ad2351bb1",
      "name": "Setup Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        0
      ],
      "parameters": {
        "jsCode": "// Turns the Clinic Setup, Prices and Dentists tabs into rows for the noor_setup data table.\nfunction rows(n) { try { return $(n).all().map(function (i) { return i.json || {}; }); } catch (e) { return []; } }\nfunction s(v) { return v === undefined || v === null ? '' : String(v).trim(); }\nconst out = [];\nlet n = 0;\nrows('Read Clinic Tab').forEach(function (r) { if (s(r.setting)) out.push({ tab: 'clinic', name: s(r.setting), value: s(r.value), option: '', words: '', minutes: '', notes: s(r.notes), sort: n++ }); });\nrows('Read Prices Tab').forEach(function (r) { if (s(r.service) && s(r.price) !== '') out.push({ tab: 'price', name: s(r.service), value: s(r.price).replace(/[^0-9.]/g, ''), option: s(r.from).toLowerCase(), words: s(r.keywords), minutes: s(r.minutes) || '30', notes: s(r.notes), sort: n++ }); });\nrows('Read Dentists Tab').forEach(function (r) { if (s(r.dentist)) out.push({ tab: 'dentist', name: s(r.dentist), value: s(r.specialty), option: s(r.gender), words: s(r.keywords), minutes: '', notes: s(r.days), sort: n++ }); });\nreturn out.map(function (r) { return { json: r }; });\n",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "executeOnce": true
    },
