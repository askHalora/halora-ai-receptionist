    {
      "id": "49680030-4589-4ab5-886d-a74dba90f040",
      "name": "Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Compares each case with what was expected: tools called, text that must / must not appear, reply language.\nconst turns = $('Build Turns').all().map(function (i) { return i.json; });\nconst answers = $input.all().map(function (i) { return i.json || {}; });\nconst cases = {};\nturns.forEach(function (t, i) {\n  const a = answers[i] || {};\n  const c = cases[t.case_id] = cases[t.case_id] || { meta: t, replies: [], tools: [], chars: 0, error: '' };\n  c.meta = t;\n  c.replies.push(String(a.reply || ''));\n  String(a.tools || '').split(',').filter(Boolean).forEach(function (x) { c.tools.push(x); });\n  c.chars = Math.max(c.chars, Number(a.prompt_chars || 0));\n  if (a.error || !a.reply) c.error = String((a.error && (a.error.message || a.error)) || 'no reply');\n});\nconst rows = Object.keys(cases).map(function (id) {\n  const c = cases[id];\n  const m = c.meta;\n  const last = c.replies[c.replies.length - 1] || '';\n  const all = c.replies.join('\\n');\n  const why = [];\n  if (c.error) why.push('error: ' + c.error);\n  String(m.expect_tools).split(',').map(function (x) { return x.trim(); }).filter(Boolean).forEach(function (x) {\n    if (x.charAt(0) === '!') { if (c.tools.indexOf(x.slice(1)) >= 0) why.push('should not call ' + x.slice(1)); }\n    else if (c.tools.indexOf(x) < 0) why.push('did not call ' + x);\n  });\n  if (m.expect_text) { try { if (!new RegExp(m.expect_text, 'i').test(last)) why.push('missing: ' + m.expect_text); } catch (e) { why.push('bad expect pattern'); } }\n  if (m.forbid_text) { try { if (new RegExp(m.forbid_text, 'i').test(all)) why.push('said forbidden: ' + m.forbid_text); } catch (e) { why.push('bad forbid pattern'); } }\n  const ar = (last.match(/[\\u0600-\\u06FF]/g) || []).length;\n  const hi = (last.match(/[\\u0900-\\u097F]/g) || []).length;\n  if (m.language === 'ar' && ar < 10) why.push('reply not in Arabic');\n  if (m.language === 'hi' && hi < 10) why.push('reply not in Hindi');\n  if (m.language === 'en' && (ar > 10 || hi > 10)) why.push('reply not in English');\n  return { json: { run: m.run, case_id: id, area: m.area, result: why.length ? 'FAIL' : 'PASS', reason: why.join('; '), reply: last.slice(0, 700), tools: c.tools.join(','), prompt_chars: c.chars } };\n});\nreturn rows;\n"
      }
    },
