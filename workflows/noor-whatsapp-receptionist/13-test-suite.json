      "id": "63fad262-e03c-495a-9acd-fb2251bec901",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Score').all().map(function (i) { return i.json; });\nconst failed = rows.filter(function (r) { return r.result === 'FAIL'; });\nconst avg = Math.round(rows.reduce(function (s, r) { return s + (r.prompt_chars || 0); }, 0) / Math.max(1, rows.length));\nreturn [{ json: { run: rows.length ? rows[0].run : '', total: rows.length, passed: rows.length - failed.length, score: Math.round(100 * (rows.length - failed.length) / Math.max(1, rows.length)) + '%', average_prompt_chars: avg, failed: failed.map(function (r) { return r.case_id + ' (' + r.area + '): ' + r.reason; }) } }];\n"
      }
