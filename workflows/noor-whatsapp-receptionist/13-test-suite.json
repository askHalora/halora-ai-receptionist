    {
      "id": "28c662bc-f56d-4c75-a495-58290da9cd6b",
      "name": "Build Turns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per message. Every case gets its own fake phone (9715000009...), unique per run, so history never mixes.\nconst run = DateTime.now().setZone('Asia/Dubai').toFormat('MMddHHmm');\nconst out = [];\n$input.all().forEach(function (it, i) {\n  const c = it.json || {};\n  let t = {};\n  try { t = JSON.parse(c.turns || '{}'); } catch (e) { t = {}; }\n  const phone = '000000000000' + run.slice(4) + String(i + 10);\n  (t.msgs || []).forEach(function (m, k) {\n    out.push({ json: { run: run, case_id: c.case_id, area: c.area, turn: k, last: k === (t.msgs.length - 1), phone: phone, text: m, patient: JSON.stringify(t.patient || {}), expect_tools: c.expect_tools || '', expect_text: c.expect_text || '', forbid_text: c.forbid_text || '', language: c.language || '' } });\n  });\n});\nreturn out;\n"
      }
    },
