    {
      "id": "0377ff4f-2c2b-493a-b73c-8fc36f65bcbc",
      "name": "Clean Owner Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "jsCode": "let t = String($json.output || '').trim();\nt = t.replace(/\\*\\*(.+?)\\*\\*/g, '*$1*');            // WhatsApp bold uses single stars\nt = t.replace(/^#{1,6}\\s*/gm, '');                   // no markdown headings\nt = t.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^)]+)\\)/g, '$1: $2'); // plain links\nt = t.replace(/\\n{3,}/g, '\\n\\n');\nif (!t) t = 'Sorry, something went wrong on my side. A team member will reply to you shortly.';\nif (t.length > 3500) t = t.slice(0, 3500) + '…';\nreturn { json: { reply: t } };\n",
        "language": "javaScript",
        "mode": "runOnceForEachItem"
      }
    },
