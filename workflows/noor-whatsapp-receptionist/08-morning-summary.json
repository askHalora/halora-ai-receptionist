    {
      "id": "4c80b78a-80f8-48cc-8ee6-645cce3b75fd",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// WhatsApp template variables must be ONE line: no line breaks or tabs.\nconst Z = 'Asia/Dubai';\nconst now = DateTime.now().setZone(Z);\nconst today = now.toFormat('yyyy-MM-dd');\nconst patients = $('Read Patients').all().map(i => i.json).filter(p => p.phone);\nconst events = $('Today\\'s Appointments').all().map(i => i.json).filter(e => e && e.start && (e.start.dateTime || e.start.date));\nconst todays = patients.filter(p => String(p.appointment_start || '').startsWith(today) && /booked|confirmed/i.test(String(p.status || '')));\nconst confirmed = todays.filter(p => /confirmed/i.test(String(p.status))).length;\nconst yesterday = now.minus({ days: 1 });\nconst newLeads = patients.filter(p => String(p.status || '').toLowerCase() === 'lead' && p.last_message_at && DateTime.fromFormat(String(p.last_message_at), 'yyyy-MM-dd HH:mm', { zone: Z }) >= yesterday).length;\nconst human = patients.filter(p => String(p.status || '').toLowerCase() === 'human').length;\nconst list = events.slice(0, 8).map(e => DateTime.fromISO(e.start.dateTime || e.start.date, { zone: Z }).toFormat('HH:mm') + ' ' + String(e.summary || '').replace(/\\s+/g, ' ')).join('; ');\nlet summary = events.length + ' appointments today (' + confirmed + ' confirmed by patients)' + (list ? ': ' + list + (events.length > 8 ? '; ...' : '') : '') + '. New leads in the last 24h: ' + newLeads + '. Waiting for a human reply: ' + human + '.';\nsummary = summary.replace(/[\\n\\t]+/g, ' ').replace(/ {2,}/g, ' ').slice(0, 900);\nreturn [{ json: { date: now.toFormat('cccc d LLLL'), summary } }];\n"
      }
    },
    {
      "id": "752fb2ef-c596-4180-a42d-7fcf4a5a10ec",
      "name": "Send Summary to Owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        896,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "REPLACE_ME",
        "recipientPhoneNumber": "={{ (() => { try { const r = $('Get Setup').all().map(i => i.json || {}).find(x => x.tab === 'clinic' && x.name === 'owner_phone'); const p = r ? String(r.value).replace(/\\D/g, '') : ''; return p.length >= 8 ? p : '000000000000'; } catch (e) { return '000000000000'; } })() }}",
        "template": "daily_summary|en",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "={{ $json.date }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.summary }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "webhookId": "REPLACE_ME"
    },
