      "id": "4d3cd870-0d07-4ba0-9b8e-48c886eda756",
      "name": "Build Setup Pack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "jsCode": "// Turns the clinic's form answers into rows for the clinic Sheet tabs.\nconst b = ($input.first().json.body) || {};\nconst s = v => String(v == null ? '' : v).replace(/[\\t\\r]/g, ' ').replace(/\\n+/g, ' / ').trim().slice(0, 1500);\nconst arr = v => Array.isArray(v) ? v.slice(0, 80) : [];\nif (b.website_hp) return [{ json: { spam: true } }];\nconst days = ['saturday','sunday','monday','tuesday','wednesday','thursday','friday'];\nconst hours = b.hours || {};\nconst setup = [\n  ['clinic_name', s(b.clinic_name)], ['assistant_name', s(b.assistant_name) || 'Noor'], ['clinic_type', s(b.clinic_type)],\n  ['address', s(b.address)], ['map_link', s(b.map_link)], ['parking', s(b.parking)], ['currency', s(b.currency) || 'AED'],\n  ['owner_phone', s(b.owner_phone).replace(/\\D/g,'')], ['clinic_whatsapp', s(b.clinic_whatsapp).replace(/\\D/g,'')], ['support_phone', s(b.support_phone).replace(/\\D/g,'')],\n  ...days.map(d => ['hours_' + d, s(hours[d]) || 'closed']),\n  ['closed_dates', s(b.closed_dates)], ['slot_minutes', s(b.slot_minutes) || '30'], ['late_cancel_hours', s(b.late_cancel_hours)],\n  ['payment', s(b.payment)], ['insurance', s(b.insurance)], ['languages', s(b.languages) || 'English, Arabic'],\n  ['tone', s(b.tone)], ['emergency_number', s(b.emergency_number) || '999'], ['google_review_link', s(b.google_review_link)],\n  ['policies', s(b.policies)], ['website', s(b.website)]\n];\nconst services = arr(b.services).filter(x => x && s(x.name));\nconst doctors = arr(b.doctors).filter(x => x && s(x.name));\nconst faqs = arr(b.faqs).filter(x => x && s(x.q));\nconst prices = services.map(x => [s(x.name), s(x.price), x.from ? 'yes' : '', s(x.minutes), s(x.name).toLowerCase(), s(x.doctor)]);\nconst docs = doctors.map(x => [s(x.name), s(x.specialty), s(x.gender), s(x.services).toLowerCase() + (x.days ? ' | days: ' + s(x.days) : '') + (x.languages ? ' | ' + s(x.languages) : '')]);\nconst kb = faqs.map(x => [s(x.q), s(x.a)]);\nconst need = [];\nif (!s(b.clinic_name)) need.push('clinic name');\nif (!s(b.contact_phone)) need.push('contact WhatsApp');\nif (!services.length) need.push('services & prices');\nif (!doctors.length) need.push('doctors');\nif (!days.some(d => s(hours[d]) && s(hours[d]).toLowerCase() !== 'closed')) need.push('opening hours');\nif (!s(b.address)) need.push('address');\nconst tsv = rows => rows.map(r => r.join('\\t')).join('\\n');\nreturn [{ json: {\n  spam: false,\n  clinic_name: s(b.clinic_name), contact_name: s(b.contact_name), contact_phone: s(b.contact_phone).replace(/\\D/g,''),\n  contact_email: s(b.contact_email), clinic_type: s(b.clinic_type), plan: s(b.plan), pilot_mode: s(b.pilot_mode) || 'fast', lang: s(b.lang) || 'en',\n  payload_json: JSON.stringify(b).slice(0, 60000),\n  clinic_setup_tsv: 'setting\\tvalue\\n' + tsv(setup),\n  prices_tsv: 'service\\tprice\\tfrom\\tminutes\\tkeywords\\tnotes\\n' + tsv(prices),\n  doctors_tsv: 'dentist\\tspecialty\\tgender\\tkeywords\\n' + tsv(docs),\n  knowledge_tsv: 'question\\tanswer\\n' + tsv(kb),\n  missing: need.join(', '),\n  counts: services.length + ' services, ' + doctors.length + ' doctors, ' + faqs.length + ' FAQs'\n} }];"
      }
    },
