    {
      "id": "fa114c93-2173-4cde-a88d-eb111e5e6a1b",
      "name": "Build Portal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        192
      ],
      "parameters": {
        "jsCode": "// Builds the owner dashboard: stats, appointment requests and recent conversations.\nconst a = $('Authorize').first().json;\nconst reqs = $('Get Requests').all().map(i => i.json).filter(x => x.id && x.service !== undefined);\nconst msgs = $('Get Chats').all().map(i => i.json).filter(x => x.id && x.role);\nconst week = Date.now() - 7 * 864e5;\nconst sessions = {};\nmsgs.slice().reverse().forEach(m => { (sessions[m.session] = sessions[m.session] || []).push({ r: m.role, t: m.text, at: m.createdAt }); });\nconst convs = Object.keys(sessions).map(k => ({ id: k, msgs: sessions[k].slice(-20), last: sessions[k][sessions[k].length - 1].at })).sort((x, y) => String(y.last).localeCompare(String(x.last))).slice(0, 40);\nconst stats = {\n  conversations: Object.keys(sessions).length,\n  patient_messages: msgs.filter(m => m.role === 'user').length,\n  requests: reqs.length,\n  new_requests: reqs.filter(x => x.status === 'new').length,\n  requests_week: reqs.filter(x => Date.parse(x.createdAt) > week).length,\n  after_hours: msgs.filter(m => { if (m.role !== 'user') return false; const h = new Date(m.createdAt).getUTCHours(); return h < 5 || h >= 16; }).length\n};\nreturn [{ json: { ok: true, clinic: { name: a.clinic_name, package: a.package, features: a.features, chat_url: a.chat_url, site_url: String(a.features).includes('website') ? 'https://askhalora.com/site/?c=' + a.c : '', agent_id: a.agent_id, whatsapp_status: a.whatsapp_status }, stats, requests: reqs.slice(0, 100).map(x => ({ id: x.id, at: x.createdAt, name: x.patient_name, phone: x.patient_phone, service: x.service, time: x.preferred_time, note: x.note, status: x.status, via: x.session === 'phone' ? 'phone' : 'chat' })), conversations: convs } }];"
      }
    },
