    {
      "id": "2e1fe343-8aef-438d-a0d2-3ab4827675c2",
      "name": "Read API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        480
      ],
      "parameters": {
        "jsCode": "// Reads the request from the clinic website, owner portal or phone agent.\nconst j = $input.first().json; const b = Object.assign({}, j.query || {}, j.body || {});\nconst s = (v, n) => String(v == null ? '' : v).trim().slice(0, n || 300);\nreturn [{ json: { action: s(b.action, 20), c: s(b.c, 60).toLowerCase().replace(/[^a-z0-9-]/g, ''), k: s(b.k, 60), id: s(b.id, 20), status: s(b.status, 20) || 'done', text: s(b.text, 1500), name: s(b.name), phone: s(b.phone), service: s(b.service), time: s(b.time), note: s(b.note) } }];"
      }
    },
    {
      "id": "1d077dfe-8f48-4523-8da8-30263d4dce9a",
      "name": "Get Clinic",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
        480
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_ME",
          "cachedResultName": "REPLACE_ME"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "clinic_id",
              "condition": "eq",
              "keyValue": "={{ $json.c }}"
            }
          ]
        },
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "3b825726-8bb5-45b5-968d-46074177a431",
      "name": "Authorize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        480
      ],
      "parameters": {
        "jsCode": "// Decides what this caller may see. Portal actions need the clinic's secret key.\nconst r = $('Read API').first().json; const cl = $input.first().json || {};\nconst exists = !!cl.clinic_id && cl.enabled !== 'no';\nconst feats = String(cl.features || '').split(',');\nconst keyOk = exists && !!r.k && r.k === cl.portal_key;\nlet route = 'deny';\nif (r.action === 'site' && exists && feats.includes('website')) route = 'site';\nelse if (r.action === 'portal' && keyOk) route = 'portal';\nelse if (r.action === 'done' && keyOk) route = 'done';\nelse if (r.action === 'change' && keyOk) route = 'change';\nelse if (r.action === 'phone_request' && exists) route = 'phone';\nlet site = {}; try { site = JSON.parse(cl.site_json || '{}'); } catch (e) {}\nconst agent = /^error/.test(cl.phone_agent_id || '') ? '' : (cl.phone_agent_id || '');\nreturn [{ json: Object.assign({}, r, { route, clinic_name: cl.clinic_name || '', site, chat_url: cl.chat_url || '', agent_id: agent, features: cl.features || '', package: cl.package || '', whatsapp_status: cl.whatsapp_status || '', alert_phone: cl.alert_phone || '000000000000', enabled: cl.enabled || '' }) }];"
      }
    },
    {
      "id": "a895d8b9-1052-4e03-84c5-2cfb349b87b8",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        416
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "site",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "site"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "portal",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
