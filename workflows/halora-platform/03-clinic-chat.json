    {
      "id": "d610fef9-854f-49d4-a4da-20db1cb52d5a",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        256
      ],
      "parameters": {
        "jsCode": "// Builds the prompt: last messages of this chat + the new message. Caps long chats to protect usage.\nconst inp = $('Read Input').first().json;\nconst clinic = $('Get Clinic').first().json;\nconst hist = $input.all().map(i => i.json).filter(r => r.role).reverse();\nconst userCount = hist.filter(r => r.role === 'user').length;\nconst lines = hist.slice(-12).map(r => (r.role === 'user' ? 'Patient: ' : 'You: ') + r.text);\nconst today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\nconst text = (lines.length ? 'Conversation so far:\\n' + lines.join('\\n') + '\\n\\n' : '') + 'Patient: ' + inp.message + '\\n\\nWrite your next reply to the patient.';\nreturn [{ json: { text, system: clinic.system_prompt + '\\n\\nToday is ' + today + '.', over: userCount >= 30 } }];"
      }
    },
