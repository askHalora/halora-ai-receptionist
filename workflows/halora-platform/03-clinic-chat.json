    {
      "id": "d7b9b37c-0cc2-41a0-a068-388fb01d800d",
      "name": "Read Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        256
      ],
      "parameters": {
        "jsCode": "// Cleans the incoming chat message from the website widget.\nconst b = $input.first().json.body || {};\nconst c = String(b.c || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 60);\nconst session = String(b.session || '').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 40) || 'anon';\nconst message = String(b.message || '').trim().slice(0, 1000);\nreturn [{ json: { c, session, message, init: !message } }];"
      }
    },
    {
      "id": "cf205a61-9edb-4002-87ea-5bf408ac7f06",
