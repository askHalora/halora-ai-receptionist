    {
      "id": "c534e424-0dce-466e-b0e8-031b457fc672",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        112
      ],
      "parameters": {
        "jsCode": "// Splits the AI answer into the visible reply and an optional appointment request.\nconst out = String($input.first().json.output || '');\nconst m = out.match(/\\[\\[REQUEST\\]\\]([\\s\\S]*?)\\[\\[\\/REQUEST\\]\\]/);\nlet req = null;\nif (m) { try { req = JSON.parse(m[1]); } catch (e) { req = { note: m[1].slice(0, 300) }; } }\nconst reply = out.replace(/\\[\\[REQUEST\\]\\][\\s\\S]*?(\\[\\[\\/REQUEST\\]\\]|$)/, '').trim() || 'Sorry, could you say that again?';\nconst s = v => String(v == null ? '' : v).slice(0, 200);\nreturn [{ json: { reply, has_request: !!req, r_name: s(req && req.name), r_phone: s(req && req.phone), r_service: s(req && req.service), r_time: s(req && req.time), r_note: s(req && req.note) } }];"
      }
    },
