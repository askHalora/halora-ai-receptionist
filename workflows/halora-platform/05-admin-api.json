    {
      "id": "ef29e051-4bca-4b27-a512-c8d4a9d89a28",
      "name": "Check Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "jsCode": "// Checks the admin key and decides the action. Only whitelisted fields can be changed.\nconst b = $('Admin Webhook').first().json.body || {};\nconst key = ($input.first().json || {}).admin_key || '';\nconst ok = !!key && String(b.k || '') === key;\nconst allowed = { enabled: ['yes', 'no'], alert_clinic: ['yes', 'no'], whatsapp_status: ['needs_meta_connect', 'live', 'not_in_package'], status: ['pilot', 'active', 'paused', 'cancelled'] };\nconst field = String(b.field || ''), value = String(b.value || '');\nlet route = 'deny';\nif (ok && b.action === 'list') route = 'list';\nif (ok && b.action === 'set' && allowed[field] && allowed[field].includes(value)) route = 'set';\nreturn [{ json: { route, c: String(b.c || '').toLowerCase().replace(/[^a-z0-9-]/g, ''), field, value } }];"
      }
    },
    {
      "id": "85c271fb-1770-4b9b-9d5a-cb73875b0016",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        672,
        176
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "list",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "list"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "set",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "set"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Denied"
        }
      }
    },
