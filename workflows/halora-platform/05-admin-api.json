    {
      "id": "e2101e55-9d1a-45e2-9360-5cb7d09bce03",
      "name": "Build Dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "jsCode": "// Builds the admin dashboard data: every clinic with links, contacts and request counts.\nconst cl = $('Get All Clinics').all().map(i => i.json).filter(x => x.clinic_id);\nconst intakes = {}; $('Get All Intakes').all().forEach(i => { if (i.json.id) intakes[i.json.id] = i.json; });\nconst rq = $('Get All Requests').all().map(i => i.json).filter(x => x.clinic_id);\nconst clinics = cl.map(x => { const it = intakes[x.intake_id] || {}; const f = String(x.features || 'chat'); return {\n  c: x.clinic_id, name: x.clinic_name, package: x.package || 'pilot', features: f, enabled: x.enabled, alert_clinic: x.alert_clinic, whatsapp_status: x.whatsapp_status || '', status: x.status, created: x.createdAt,\n  contact: it.contact_name || '', email: it.contact_email || '', phone: String(it.contact_phone || x.clinic_phone || '').replace(/\\D/g, ''),\n  chat_url: x.chat_url, site_url: f.includes('website') ? 'https://askhalora.com/site/?c=' + x.clinic_id : '',\n  portal_url: x.portal_key ? 'https://askhalora.com/portal/?c=' + x.clinic_id + '&k=' + x.portal_key : '',\n  agent: /^agent_/.test(x.phone_agent_id || '') ? x.phone_agent_id : '',\n  requests: rq.filter(r => r.clinic_id === x.clinic_id).length, new_requests: rq.filter(r => r.clinic_id === x.clinic_id && r.status === 'new').length\n}; }).sort((a, b) => String(b.created).localeCompare(String(a.created)));\nconst requests = rq.slice(0, 60).map(r => ({ at: r.createdAt, clinic: r.clinic_name, name: r.patient_name, phone: r.patient_phone, service: r.service, time: r.preferred_time, status: r.status, via: r.session === 'phone' ? 'phone' : 'chat' }));\nreturn [{ json: { ok: true, clinics, requests } }];"
      }
    },
